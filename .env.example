PORT=3000
# Required in production — long random string; only your admin tools know this
ADMIN_API_KEY=change-me-to-a-long-random-secret

# Where SQLite stores state (mount a Render persistent disk here in production)
DATA_DIR=./data

# Comma-separated origins allowed to read /api/v1/status from browsers (optional)
# Use * only if you proxy status server-side. Example:
# CORS_ORIGINS=https://myapp.com,https://www.myapp.com
CORS_ORIGINS=*
